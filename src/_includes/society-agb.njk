{% set s = societySite.de %}
{% set isHome = false %}
{% set pageTitle = title %}
{% set pageDescription = description %}
{% set canonicalPath = page.url %}
{% set hideLanguageSwitch = true %}
<!DOCTYPE html>
<html lang="{{ lang or 'de' }}">
<head>
{% include "society-head.njk" %}
</head>
<body class="society-page">
<a href="#main" class="skip">{{ s.skip }}</a>
{% include "society-site-header.njk" %}
<main id="main">
  <section class="interior-hero">
    <div class="wrap-inner">
      <a class="back-link" href="/"><span aria-hidden="true">←</span><span>{{ s.backHome }}</span></a>
      <p class="eyebrow">Rechtliche Hinweise · Fassung vom 15.&nbsp;September&nbsp;2026</p>
      <h1>Allgemeine Geschäfts&shy;bedingungen</h1>
      <p class="interior-lead">Vertragsbedingungen für weitere Bildungsangebote des Vereins Lerngesellschaft. Für den Lernbus gelten eigene AGB für Eltern und Erziehungsberechtigte.</p>
    </div>
  </section>
  <section class="interior-body">
    <div class="wrap-inner">
      <div class="agb-prose">
        {{ content | safe }}
      </div>
    </div>
  </section>
</main>
{% include "society-site-footer.njk" %}
</body>
</html>
