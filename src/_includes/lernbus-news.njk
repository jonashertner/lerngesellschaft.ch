<section class="section news-section" id="aktuelles" aria-labelledby="news-heading">
  <div class="wrap news-grid">
    <div class="news-intro">
      <p class="eyebrow">{% if locale == "en" %}November and December 2026{% else %}November und Dezember 2026{% endif %}</p>
      <h2 class="big" id="news-heading">{% if locale == "en" %}News / Dates{% else %}Aktuelles&nbsp;/ Termine{% endif %}</h2>
      <h3>{% if locale == "en" %}Get to know Lernbus, without obligation.{% else %}Den Lernbus unverbindlich kennenlernen.{% endif %}</h3>
      <p>{% if locale == "en" %}Drop by, get to know us and ask your questions. These are the next dates:{% else %}Kommen Sie vorbei, lernen Sie uns kennen und stellen Sie Ihre Fragen. Das sind die nächsten Termine:{% endif %}</p>
      <a class="morelink" href="{{ '/lernbus/en/open-doors-2026.ics' if locale == 'en' else '/lernbus/offene-tueren-2026.ics' }}" download>{% if locale == "en" %}Save dates to your calendar{% else %}Termine im Kalender speichern{% endif %} <span aria-hidden="true">↓</span></a>
      <img class="news-maedchen" src="/lernbus/img/lernbus-maedchen.webp" srcset="/lernbus/img/lernbus-maedchen-small.webp 164w, /lernbus/img/lernbus-maedchen.webp 327w" sizes="(max-width: 48rem) 200px, 300px" width="327" height="214" alt="" aria-hidden="true" loading="lazy" decoding="async">
    </div>
    <div class="news-dates">
      <h3>{% if locale == "en" %}Introductory sessions{% else %}Kennenlernstunden{% endif %}</h3>
      <ul class="event-list">
        {% for event in lernbusEvents %}
        <li><time datetime="{{ event.date }}">{{ event.en if locale == "en" else event.de }}</time><span>{{ event.start }}–{{ event.end }}{% if locale != "en" %} Uhr{% endif %}</span><span class="event-place">{{ event.place }}</span></li>
        {% endfor %}
      </ul>
      <p class="event-timezone">{% if locale == "en" %}All times are local to Basel.{% else %}Alle Zeiten gelten für Basel.{% endif %}</p>
    </div>
  </div>
</section>
