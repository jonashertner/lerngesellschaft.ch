<footer class="world-footer{% if not isHome %} world-footer-compact{% endif %}">
  <span class="legacy-anchor" id="investieren" aria-hidden="true"></span>
  <div class="world-footer-inner">
    <div class="footer-directory">
      <div class="footer-principle">
        <p>{{ s.footer.line | safe }}</p>
        <span>{{ s.footer.status | safe }}</span>
      </div>
      <nav aria-label="{{ s.footer.exploreTitle }}">
        <h3 class="eyebrow">{{ s.footer.exploreTitle }}</h3>
        {% for item in s.footer.explore %}<a href="{{ item.url }}"{% if canonicalPath == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
      </nav>
      <nav aria-label="{{ s.footer.legalTitle }}">
        <h3 class="eyebrow">{{ s.footer.legalTitle }}</h3>
        {% for item in s.footer.legal %}<a href="{{ item.url }}"{% if canonicalPath == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
        {% if not hideLanguageSwitch %}<div class="footer-languages"><a href="{{ deUrl or '/' }}" lang="de"{% if s.lang == 'de' %} aria-current="page"{% endif %}>Deutsch</a><a href="{{ enUrl or '/en/' }}" lang="en"{% if s.lang == 'en' %} aria-current="page"{% endif %}>English</a></div>{% endif %}
      </nav>
      <div class="footer-address">
        <h3 class="eyebrow">{{ s.footer.addressTitle }}</h3>
        <address>Münsterplatz 17<br>4051 Basel<br>{{ s.footer.country }}</address>
        <a href="mailto:team@jonashertner.com">team@jonashertner.com</a>
      </div>
    </div>
    <a class="footer-signature" href="{{ s.root }}"><span>{{ s.brand }}</span><span>{{ s.brandSub }}</span></a>
    <div class="footer-bottom">
      <span>{{ s.footer.copyright }}</span>
      <div class="footer-bottom-links">
        <a href="{{ s.footer.imprintUrl }}">{{ s.footer.imprintLabel }}</a>
        <a href="{{ s.footer.termsUrl }}">{{ s.footer.termsLabel }}</a>
        <a href="#top" class="back-top">{{ s.footer.top }}</a>
      </div>
    </div>
  </div>
</footer>
<script src="/assets/society-discovery.js?v={{ siteAssets.societyDiscovery }}" defer></script>
