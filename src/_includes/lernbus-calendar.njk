{% set t = lernbus[locale] %}
{% set calendar = lernbusBooking.locales[locale] or lernbusBooking %}
<div class="booking-section" data-booking-addition>
  <div class="booking-card" data-booking data-locale="{{ locale }}" data-booking-url="{{ calendar.bookingUrl | escape }}" data-embed-url="{{ calendar.embedUrl | escape }}" data-provider-name="{{ calendar.providerName | escape }}">
    <div class="booking-card-heading">
      <h3>{{ t.bookingHeading }}</h3>
      <p class="booking-meta">{{ t.bookingMeta }}</p>
    </div>
    <div class="booking-body">
      <div data-booking-fallback{% if lernbusBooking.configured %} hidden{% endif %}>
        <p class="booking-status">{{ t.bookingEmpty }}</p><p>{{ t.bookingFallback }}</p>
        <a class="button" href="mailto:{{ lernbusContact.recipient | escape }}?subject={{ t.bookingEmailSubject | urlencode }}">{{ t.bookingEmail }}</a>
        <p class="small">{{ t.bookingHint }}</p>
      </div>
      <div data-booking-ready{% if not lernbusBooking.configured %} hidden{% endif %}>
        <p class="booking-boundary">{{ t.bookingBoundary }}</p>
        <p class="booking-opening" data-calendar-opening data-first-lesson="{{ lernbusBooking.firstLessonDate }}" hidden>{{ t.calendarOpening }}</p>
        <div class="calendar-launch" data-calendar-launch hidden>
          <button class="button" type="button" data-calendar-load aria-controls="lesson-calendar" aria-expanded="false" hidden>{{ t.calendarLoad }}</button>
          <p class="booking-disclosure">{{ t.calendarPrivacy }}</p>
        </div>
        <div class="calendar-tools">
          <a class="text-link" data-calendar-external href="{{ calendar.bookingUrl | escape }}" target="_blank" rel="noopener noreferrer">{{ t.calendarExternal }} <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="{{ t.privacyHref }}">{{ t.privacy }}</a>
          <a class="text-link" href="{{ t.termsHref }}">{{ t.terms }}</a>
        </div>
        <p class="calendar-status small" data-calendar-status data-loading="{{ t.calendarLoading }}" data-slow="{{ t.calendarSlow }}" role="status" hidden></p>
      </div>
      <p class="booking-error" data-booking-error role="status" hidden>{{ t.calendarUnavailable }}</p>
    </div>
    <div class="calendar-frame" id="lesson-calendar" data-calendar-frame hidden></div>
    <div class="calendar-assistance" data-calendar-assistance hidden>
      <p class="small">{{ t.calendarHelp }}</p>
      <div class="calendar-tools">
        <a class="text-link" href="{{ calendar.bookingUrl | escape }}" target="_blank" rel="noopener noreferrer">{{ t.calendarExternal }} <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="mailto:{{ lernbusContact.recipient | escape }}?subject={{ t.bookingEmailSubject | urlencode }}">{{ t.bookingEmail }}</a>
      </div>
    </div>
    {% if lernbusBooking.weeklySlots.length %}<details class="weekly-times"><summary>{{ t.weeklyHeading }} <span aria-hidden="true">+</span></summary><p class="small">{% if lernbusBooking.configured %}{{ t.weeklyLiveNote }}{% else %}{{ t.weeklyNote }}{% endif %}</p><dl>{% for day in lernbusBooking.weeklySlots %}<div><dt>{{ t.weekdays[day.day] }}</dt><dd>{% for slot in day.slots %}<span>{{ slot }}</span>{% endfor %}</dd></div>{% endfor %}</dl></details>{% endif %}
  </div>
</div>
