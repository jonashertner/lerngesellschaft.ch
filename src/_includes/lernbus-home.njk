{% set t = lernbus[locale] %}
<!doctype html>
<html lang="{{ t.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fbfaf3">
  <title>{{ t.title }}</title>
  <meta name="description" content="{{ t.description }}">
  <link rel="canonical" href="https://lerngesellschaft.ch/lernbus/{% if locale == 'en' %}en/{% endif %}">
  <link rel="alternate" hreflang="de-CH" href="https://lerngesellschaft.ch/lernbus/">
  <link rel="alternate" hreflang="en" href="https://lerngesellschaft.ch/lernbus/en/">
  <meta property="og:title" content="{{ t.title }}">
  <meta property="og:description" content="{{ t.description }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{% if locale == 'de' %}de_CH{% else %}en_GB{% endif %}">
  <meta property="og:url" content="https://lerngesellschaft.ch/lernbus/{% if locale == 'en' %}en/{% endif %}">
  <link rel="icon" type="image/png" href="{{ t.prefix }}img/favicon.png">
  <link rel="apple-touch-icon" href="{{ t.prefix }}img/apple-touch-icon.png">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ t.prefix }}fonts/bricolage-latin.woff2">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ t.prefix }}fonts/hanken-latin.woff2">
  <link rel="stylesheet" href="{{ t.prefix }}home.css">
  <script src="{{ t.prefix }}home.js" defer></script>
  <script src="{{ t.prefix }}booking.js" type="module"></script>
</head>
<body id="top">
  <a class="skip-link" href="#main">{{ t.skip }}</a>
  <header class="header">
    <div class="shell header-inner">
      <a class="logo" href="{% if locale == 'en' %}./{% else %}./{% endif %}" aria-label="Lernbus">
        <img src="{{ t.prefix }}img/logo.png" width="800" height="344" alt="Lernbus">
      </a>
      <span class="brand-context">{{ t.brand }}<br>Basel</span>
      <nav class="desktop-nav" aria-label="{% if locale == 'de' %}Hauptnavigation{% else %}Main navigation{% endif %}">
        <a href="#ansatz">{{ t.nav[0] }}</a><a href="#ablauf">{{ t.nav[1] }}</a><a href="#kosten">{{ t.nav[2] }}</a><a href="#fragen">{{ t.nav[3] }}</a>
      </nav>
      <a class="language" href="{{ t.alternate }}" lang="{{ t.alternateCode | lower }}" aria-label="{{ t.alternateLabel }}">{{ t.alternateCode }}</a>
      <a class="button button-small header-book" href="#gespraech">{{ t.book }} <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu">
        <summary aria-label="{{ t.menu }}"><span></span><span></span></summary>
        <nav aria-label="{% if locale == 'de' %}Mobile Navigation{% else %}Mobile navigation{% endif %}">
          <a href="#ansatz">{{ t.nav[0] }}</a><a href="#ablauf">{{ t.nav[1] }}</a><a href="#kosten">{{ t.nav[2] }}</a><a href="#fragen">{{ t.nav[3] }}</a><a href="#gespraech">{{ t.book }}</a>
        </nav>
      </details>
    </div>
  </header>
  <main id="main">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="kicker"><span class="short-line" aria-hidden="true"></span>{{ t.eyebrow }}</p>
        <h1 id="hero-title">{{ t.headline | safe }}</h1>
        <p class="hero-intro">{{ t.intro }}</p>
        <div class="hero-actions"><a class="button" href="#gespraech">{{ t.heroCta }} <span aria-hidden="true">↗</span></a><a class="text-link" href="#ansatz">{{ t.secondaryCta }} <span aria-hidden="true">↓</span></a></div>
        <p class="hero-note">{{ t.heroNote }}</p>
      </div>
      <figure class="hero-art">
        <img src="{{ t.prefix }}img/learning-box.webp" width="1254" height="1254" alt="{{ t.imageAlt }}" fetchpriority="high" sizes="(max-width: 760px) 90vw, 48vw" srcset="{{ t.prefix }}img/learning-box-small.webp 700w, {{ t.prefix }}img/learning-box.webp 1254w">
        <figcaption><span class="figure-index">↗</span><span>{{ t.imageCaption }}<small>{{ t.imageLabel }}</small></span></figcaption>
      </figure>
    </section>
    <section class="facts shell" id="zielgruppe" aria-label="{% if locale == 'de' %}Auf einen Blick{% else %}At a glance{% endif %}">
      {% for fact in t.facts %}<div><strong>{{ fact[0] }}</strong><span>{{ fact[1] }}</span></div>{% endfor %}
    </section>

    <section class="section shell" id="ansatz">
      <div class="section-heading"><div><p class="kicker">{{ t.offerLabel }}</p><h2>{{ t.offerTitle | safe }}</h2></div><p class="intro">{{ t.offerIntro }}</p></div>
      <div class="offer-grid">{% for offer in t.offers %}<article class="offer"><span class="offer-number" aria-hidden="true">0{{ loop.index }}</span><h3>{{ offer[0] }}</h3><p>{{ offer[1] }}</p></article>{% endfor %}</div>
      <div class="offer-footer"><p>{{ t.offerFoot }}</p><a class="text-link" href="{{ t.prefix }}{{ t.approachHref }}">{{ t.approachLink }} <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="experience" id="warum">
      <div class="shell experience-grid">
        <div class="experience-heading"><p class="kicker">{{ t.experienceLabel }}</p><h2>{{ t.experienceTitle | safe }}</h2><p>{{ t.experienceIntro }}</p><img src="{{ t.prefix }}img/plane.png" alt="" width="248" height="130" loading="lazy"></div>
        <div class="learning-story" data-story>
          <div class="story-tabs" role="tablist" hidden aria-label="{% if locale == 'de' %}Beispiel eines Lernwegs{% else %}An example learning journey{% endif %}">
            {% for example in t.examples %}<button type="button" role="tab" id="story-tab-{{ loop.index }}" aria-controls="story-panel-{{ loop.index }}" aria-selected="{% if loop.first %}true{% else %}false{% endif %}" tabindex="{% if loop.first %}0{% else %}-1{% endif %}"><span>0{{ loop.index }}</span>{{ example[0] }}</button>{% endfor %}
          </div>
          {% for example in t.examples %}<div class="story-panel" role="tabpanel" id="story-panel-{{ loop.index }}" aria-labelledby="story-tab-{{ loop.index }}" tabindex="0">
            <span class="story-number" aria-hidden="true">0{{ loop.index }}</span><h3>{{ example[1] }}</h3><p>{{ example[2] }}</p><p class="story-skills">{{ example[3] }}</p>
          </div>{% endfor %}
          <p class="example-note">{{ t.exampleNote }}</p>
        </div>
      </div>
    </section>

    <section class="section shell" id="ablauf">
      <div class="section-heading"><div><p class="kicker">{{ t.stepsLabel }}</p><h2>{{ t.stepsTitle | safe }}</h2></div><a class="text-link" href="#gespraech">{{ t.heroCta }} <span aria-hidden="true">↗</span></a></div>
      <ol class="steps">{% for step in t.steps %}<li><span class="step-count" aria-hidden="true">{{ loop.index }}</span><h3>{{ step[0] }}</h3><p>{{ step[1] }}</p></li>{% endfor %}</ol>
      <aside class="quality" id="qualitaet"><h3>{{ t.qualityTitle }}</h3><div><p>{{ t.quality }}</p><a class="text-link" href="{{ t.prefix }}team/{% if locale == 'en' %}en/{% endif %}">{{ t.qualityLink }} <span aria-hidden="true">↗</span></a></div></aside>
    </section>

    <section class="costs" id="kosten">
      <div class="shell">
        <div class="section-heading"><div><p class="kicker">{{ t.costLabel }}</p><h2>{{ t.costTitle }}</h2></div><p class="intro">{{ t.costIntro }}</p></div>
        <table class="price-table">
          <caption>{{ t.tariffUnit }}</caption>
          <thead><tr>{% for h in t.tariffHeaders %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
          <tbody>{% for tariff in t.tariffs %}<tr><th scope="row"><strong>{{ tariff[0] }}</strong><span>{{ tariff[1] }}</span></th><td>{{ tariff[2] }}</td><td>{{ tariff[3] }}</td></tr>{% endfor %}</tbody>
        </table>
        <div class="support-note"><div><h3>{{ t.supportTitle }}</h3><p>{{ t.support }}</p></div><a class="button button-light" href="#gespraech">{{ t.costCta }} <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="section shell booking-section" id="gespraech">
      <div class="booking-intro"><p class="kicker">{{ t.bookingLabel }}</p><h2>{{ t.bookingTitle | safe }}</h2><p class="intro">{{ t.bookingIntro }}</p><ul class="booking-meta">{% for item in t.bookingMeta %}<li>{{ item }}</li>{% endfor %}</ul><a class="contact-link" href="mailto:info@lernbus.ch">info@lernbus.ch</a></div>
      <div class="booking-card" data-booking data-locale="{{ locale }}" data-booking-url="{{ lernbusBooking.bookingUrl | escape }}" data-embed-url="{{ lernbusBooking.embedUrl | escape }}" data-provider-name="{{ lernbusBooking.providerName | escape }}">
        <div class="booking-card-heading"><span class="calendar-icon" aria-hidden="true">▦</span><h3>{{ t.bookingHeading }}</h3></div>
        <div class="booking-unconfigured" data-booking-fallback{% if lernbusBooking.configured %} hidden{% endif %}>
          <p class="booking-status">{{ t.bookingEmpty }}</p><p>{{ t.bookingFallback }}</p>
          <a class="button" href="mailto:info@lernbus.ch?subject={{ t.bookingEmailSubject | urlencode }}">{{ t.bookingEmail }} <span aria-hidden="true">↗</span></a>
          <p class="small">{{ t.bookingHint }}</p>
        </div>
        <div data-booking-ready{% if not lernbusBooking.configured %} hidden{% endif %}>
          <p class="booking-disclosure">{{ t.calendarPrivacy }}</p>
          <button class="button" type="button" data-calendar-load hidden>{{ t.calendarLoad }} <span aria-hidden="true">↗</span></button>
          <p class="small" data-calendar-help>{{ t.calendarHelp }}</p>
          <a class="text-link" data-calendar-external href="{{ lernbusBooking.bookingUrl | escape }}" target="_blank" rel="noopener noreferrer">{{ t.calendarExternal }} <span aria-hidden="true">↗</span></a>
          <div class="calendar-frame" data-calendar-frame hidden></div>
        </div>
        <p class="booking-error" data-booking-error role="status" hidden>{{ t.calendarUnavailable }}</p>
        {% if lernbusBooking.weeklySlots.length %}<details class="weekly-times"><summary>{{ t.weeklyHeading }} <span aria-hidden="true">+</span></summary><p class="small">{% if lernbusBooking.configured %}{{ t.weeklyLiveNote }}{% else %}{{ t.weeklyNote }}{% endif %}</p><dl>{% for day in lernbusBooking.weeklySlots %}<div><dt>{{ t.weekdays[day.day] }}</dt><dd>{% for slot in day.slots %}<span>{{ slot }}</span>{% endfor %}</dd></div>{% endfor %}</dl></details>{% endif %}
        <p class="booking-privacy"><a href="{{ t.privacyHref }}">{{ t.privacy }}</a></p>
      </div>
    </section>

    <section class="faq-section shell" id="fragen"><div><p class="kicker">{{ t.faqLabel }}</p><h2>{{ t.faqTitle }}</h2><a class="text-link" href="mailto:info@lernbus.ch">info@lernbus.ch <span aria-hidden="true">↗</span></a></div><div class="faq-list">{% for faq in t.faqs %}<details><summary>{{ faq[0] }}<span aria-hidden="true">+</span></summary><p>{{ faq[1] }}</p></details>{% endfor %}</div></section>
  </main>
  <footer class="footer" id="traegerschaft"><div class="shell">
    <div class="footer-main"><h2>{{ t.footerTitle | safe }}</h2><div><p>{{ t.footerCopy }}</p><a class="text-link" href="https://lerngesellschaft.ch/{% if locale == 'en' %}vorschau/en/{% endif %}">{{ t.association }} <span aria-hidden="true">↗</span></a></div></div>
    <div class="footer-bottom"><a href="#top" aria-label="{{ t.footerTop }}"><img src="{{ t.prefix }}img/logo.png" width="800" height="344" alt="Lernbus" loading="lazy"></a><span>Münsterplatz 17<br>4051 Basel</span><a href="mailto:info@lernbus.ch">info@lernbus.ch</a><a href="{{ t.legalHref }}">{{ t.legal }}</a><span class="copyright">{{ t.copyright }}</span></div>
  </div></footer>
</body>
</html>
