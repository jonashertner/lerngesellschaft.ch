{% set contactEnglish = locale == 'en' %}
<section class="section contact-section" id="kontakt">
  <span id="gespraech" class="contact-anchor" aria-hidden="true"></span>
  <div class="wrap contact-grid">
    <div class="contact-intro">
      <p class="eyebrow">{% if contactEnglish %}Get in touch{% else %}Kontakt{% endif %}</p>
      <h2 class="big">{% if contactEnglish %}Request a learning session{% else %}Lernstunde anfragen{% endif %}</h2>
      <p class="lead">{% if contactEnglish %}Tell us a little about your family. We will get back to you within a few days to discuss your questions and the next steps.{% else %}Erzählen Sie uns kurz von Ihrer Familie. Wir melden uns innert weniger Tage, um Ihre Fragen und die nächsten Schritte zu besprechen.{% endif %}</p>
      <p class="contact-next">{% if contactEnglish %}Your enquiry is not a binding booking.{% else %}Ihre Anfrage ist noch keine verbindliche Buchung.{% endif %}</p>
      <a class="morelink" href="mailto:{{ lernbusContact.recipient | escape }}">{{ lernbusContact.recipient }}</a>
    </div>
    <div class="book-card contact-card">
      <form id="anfrage" action="{{ lernbusContact.endpoint | escape }}" method="post" data-direct-contact data-contact-email="{{ lernbusContact.recipient | escape }}" data-locale="{{ locale | escape }}" aria-describedby="contact-required contact-note">
        <p class="contact-required" id="contact-required">{% if contactEnglish %}All fields are required except your message.{% else %}Alle Angaben ausser der Nachricht sind erforderlich.{% endif %}</p>
        <div class="form-grid">
          <div class="field wide"><label for="f-name">{% if contactEnglish %}Parent or guardian’s name{% else %}Name eines Elternteils oder einer erziehungsberechtigten Person{% endif %}</label><input id="f-name" name="name" type="text" autocomplete="name" maxlength="120" required /></div>
          <div class="field"><label for="f-contact">{% if contactEnglish %}Email address{% else %}E-Mail-Adresse{% endif %}</label><input id="f-contact" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
          <div class="field"><label for="f-phone">{% if contactEnglish %}Phone number{% else %}Telefonnummer{% endif %}</label><input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" minlength="6" maxlength="40" required /></div>
          <div class="field wide contact-count"><label for="f-child-count">{% if contactEnglish %}Number of children{% else %}Anzahl Kinder{% endif %}</label><input id="f-child-count" name="children_count" type="number" inputmode="numeric" min="1" max="10" step="1" value="1" required /></div>
          <div class="field wide" data-age-fallback>
            <label for="f-ages">{% if contactEnglish %}Age of each child, in years{% else %}Alter jedes Kindes in Jahren{% endif %}</label>
            <input id="f-ages" name="children_ages_years" type="text" maxlength="200" aria-describedby="contact-ages-help" required />
            <p class="contact-help" id="contact-ages-help">{% if contactEnglish %}Enter one age for every child, separated by a semicolon, for example: 3; 6.5.{% else %}Geben Sie für jedes Kind ein Alter an, getrennt durch einen Strichpunkt, zum Beispiel: 3; 6,5.{% endif %}</p>
          </div>
          <fieldset class="contact-ages wide" data-child-ages hidden>
            <legend>{% if contactEnglish %}Age of each child{% else %}Alter der Kinder{% endif %}</legend>
            <p class="contact-help" id="contact-age-unit">{% if contactEnglish %}In years; you can also enter an age such as 3.5.{% else %}In Jahren; auch Angaben wie 3,5 sind möglich.{% endif %}</p>
            <div class="contact-age-grid" data-age-fields></div>
          </fieldset>
          <div class="field wide"><label for="f-msg">{% if contactEnglish %}Your message <span class="contact-optional">(optional)</span>{% else %}Ihre Nachricht <span class="contact-optional">(optional)</span>{% endif %}</label><textarea id="f-msg" name="message" rows="4" maxlength="5000"></textarea></div>
        </div>
        <div class="contact-trap" aria-hidden="true"><label for="f-website">Website</label><input id="f-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" maxlength="200" /></div>
        <input type="hidden" name="_subject" value="{% if contactEnglish %}Lernbus: request a learning session{% else %}Lernbus: Lernstunde anfragen{% endif %}" />
        <input type="hidden" name="language" value="{{ locale | escape }}" />
        <div class="contact-submit"><button type="submit" class="btn btn-pink">{% if contactEnglish %}Request a learning session{% else %}Lernstunde anfragen{% endif %}</button></div>
      </form>
      <p class="book-note" id="contact-note">{% if contactEnglish %}Your enquiry is sent directly to {{ lernbusContact.recipient }}. <a class="contact-privacy" href="/imprint/#formulare">Contact form privacy</a>{% else %}Ihre Anfrage wird direkt an {{ lernbusContact.recipient }} übermittelt. <a class="contact-privacy" href="/impressum/#formulare">Datenschutz zum Kontaktformular</a>{% endif %}</p>
      <p class="contact-status" data-contact-status role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </div>
</section>
