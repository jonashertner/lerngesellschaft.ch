{% include "society-landing-header.njk" %}
<main id="main">
  <section class="landing-hero" id="top" aria-labelledby="purpose-title">
    <div class="hero-stage" aria-hidden="true">
      <div class="hero-poster"></div>
      <video id="hero-video" class="hero-video" muted loop playsinline preload="none" width="640" height="640" poster="/assets/media/hero-poster.jpg"><source src="/assets/media/hero.webm" type="video/webm"><source src="/assets/media/hero.mp4" type="video/mp4"></video>
      <div class="hero-shade"></div>
    </div>
    <div class="wrap hero-content">
      <h1 id="purpose-title">{{ landing.title | safe }}</h1>
      <p class="hero-intro">{{ landing.intro }}</p>
      <div class="hero-action"><a class="primary-link" href="{{ landing.lernbusUrl }}">{{ landing.action }} <span aria-hidden="true">↗</span></a><span class="action-note">{{ landing.actionNote }}</span></div>
    </div>
    <div class="wrap hero-controls"><button class="film-toggle" type="button" aria-controls="hero-video" data-pause-label="{{ landing.pauseLabel }}" data-play-label="{{ landing.playLabel }}" data-pending-label="{{ landing.pendingLabel }}" hidden><span class="film-toggle-icon" aria-hidden="true">▶</span><span class="film-toggle-label">{{ landing.playLabel }}</span></button></div>
  </section>
  <section class="pillars wrap" id="wege" aria-label="{{ landing.offersLabel }}">
    <span class="legacy-anchor" id="worum" aria-hidden="true"></span><span class="legacy-anchor" id="ziele" aria-hidden="true"></span>
    <article class="pillar pillar-lernbus" id="lernbus">
      <h2>{{ landing.lernbusTitle }}</h2>
      <p class="pillar-description">{{ landing.lernbusDescription }}</p>
      <p class="pillar-status">{{ landing.lernbusStatus }}</p>
      <a class="text-link" href="{{ landing.lernbusUrl }}">{{ landing.lernbusLinkLabel }} <span aria-hidden="true">↗</span></a>
    </article>
    <article class="pillar" id="forscherbuehne">
      <p class="development-label">{{ landing.development }}</p>
      <h2>{{ landing.eventsTitle }}</h2>
      <p class="pillar-name">{{ landing.eventsName }}</p>
    </article>
    <article class="pillar" id="gehirn-und-gesellschaft">
      <p class="development-label">{{ landing.development }}</p>
      <h2>{{ landing.schoolsTitle }}</h2>
      <p class="pillar-name">{{ landing.schoolsName }}</p>
    </article>
  </section>
</main>
{% include "society-landing-footer.njk" %}
<script src="/assets/hero-video.js?v=20260915-hero"></script>
