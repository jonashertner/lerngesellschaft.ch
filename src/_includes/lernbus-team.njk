{% set member = lernbusTeam[locale] %}
<article class="team-profile" aria-labelledby="conny-name">
  <div class="team-identity">
    <div class="team-photo-frame">
      <img class="team-photo"
        src="/lernbus/img/conny-brandes-portrait.webp?v={{ lernbusAssets.portrait }}"
        srcset="/lernbus/img/conny-brandes-portrait-small.webp?v={{ lernbusAssets.portraitSmall }} 600w, /lernbus/img/conny-brandes-portrait.webp?v={{ lernbusAssets.portrait }} 1200w"
        sizes="(max-width: 48rem) 18rem, (max-width: 80rem) 32vw, 27rem"
        width="1200" height="932"
        alt="{{ member.photoDescription }}"
        loading="lazy" decoding="async" />
    </div>
    <{{ profileHeading }} class="team-name" id="conny-name">{{ member.name }}</{{ profileHeading }}>
    <p class="team-role">{{ member.role }}</p>
    <a class="morelink" href="mailto:connybrandes@lernbus.ch">connybrandes@lernbus.ch</a>
  </div>
  {% if compactProfile %}
  <div class="team-profile-copy">
    <div class="team-bio-section">
      <{{ bioHeading }} class="team-bio-heading">{{ member.sections[0].title }}</{{ bioHeading }}>
      <p>{{ member.sections[0].paragraphs[0] }}</p>
    </div>
    <details class="content-disclosure team-biography">
      <summary>{% if locale == "de" %}Mehr über Conny{% else %}More about Conny{% endif %}</summary>
      <div class="disclosure-body">
        <div class="team-bio-section"><p>{{ member.sections[0].paragraphs[1] }}</p></div>
        {% for section in member.sections %}
        {% if not loop.first %}
        <div class="team-bio-section">
          <{{ bioHeading }} class="team-bio-heading">{{ section.title }}</{{ bioHeading }}>
          {% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
        </div>
        {% endif %}
        {% endfor %}
      </div>
    </details>
  </div>
  {% else %}
  <div class="team-profile-copy">
    {% for section in member.sections %}
    <div class="team-bio-section">
      <{{ bioHeading }} class="team-bio-heading">{{ section.title }}</{{ bioHeading }}>
      {% for paragraph in section.paragraphs %}
      <p>{{ paragraph }}</p>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
</article>
