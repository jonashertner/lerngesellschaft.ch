{% set footerHome = "/lernbus/en/" if footerEnglish else "/lernbus/" %}
<footer class="foot footer-designed" id="footer">
  <div class="wrap">
    <div class="footer-mast">
      <a class="footer-brand" href="{{ footerHome }}" aria-label="{% if footerEnglish %}Lernbus home{% else %}Lernbus Startseite{% endif %}">
        <img src="/lernbus/img/logo-light.webp" alt="Lernbus" width="800" height="344" loading="lazy" decoding="async">
      </a>
      <a class="footer-booking" href="{{ footerHome }}#gespraech">
        <span>{% if footerEnglish %}Request a lesson{% else %}Lektion anfragen{% endif %}</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M4 12h15M13 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <div class="footer-columns">
      <p class="footer-identity">Lernbus · {% if footerEnglish %}a programme of{% else %}ein Angebot der{% endif %}<br><a href="https://lerngesellschaft.ch/{% if footerEnglish %}en/{% endif %}">Lerngesellschaft</a></p>
      <address class="footer-contact">
        <span>Münsterplatz 17<br>4051 Basel</span>
        <a href="mailto:info@lernbus.ch">info@lernbus.ch</a>
      </address>
      <nav class="footer-links" aria-label="{% if footerEnglish %}More about Lernbus{% else %}Mehr über Lernbus{% endif %}">
        <a href="{{ footerHome }}konzept/">{% if footerEnglish %}Our approach{% else %}Konzept{% endif %}</a>
        <a href="/lernbus/team/{% if footerEnglish %}en/{% endif %}">Team</a>
        <a href="{{ footerHome }}#kosten">{% if footerEnglish %}Fees{% else %}Kosten{% endif %}</a>
      </nav>
    </div>
    <div class="footer-base">
      <p>{% if footerEnglish %}Association · starting in October 2026{% else %}Verein · Start Oktober 2026{% endif %}</p>
      <nav class="footer-legal" aria-label="{% if footerEnglish %}Legal{% else %}Rechtliches{% endif %}">
        <a href="/{% if footerEnglish %}imprint{% else %}impressum{% endif %}/">{% if footerEnglish %}Legal information{% else %}Impressum{% endif %}</a>
        <a href="/lernbus/{% if footerEnglish %}en/terms{% else %}agb{% endif %}/">{% if footerEnglish %}Terms and conditions{% else %}AGB{% endif %}</a>
      </nav>
      <a class="footer-top" href="#top">{% if footerEnglish %}Back to top{% else %}Nach oben{% endif %}<span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
