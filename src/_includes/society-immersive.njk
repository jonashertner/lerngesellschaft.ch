<header class="world-header">
 <a class="wordmark" href="{{ landing.root }}" aria-label="{{ landing.name }} · Basel">Lerngesellschaft<span>Learning Society</span></a>
 <nav class="world-nav" aria-label="{{ experience.navLabel }}">
  <a href="#idee">{{ experience.idea }}</a><a href="#wege">{{ experience.programmes }}</a><a href="#verein">{{ experience.association }}</a>
 </nav>
 <div class="languages"><a href="/" lang="de" aria-label="Auf Deutsch"{% if landing.language == 'de' %} aria-current="page"{% endif %}>DE</a><span>/</span><a href="/en/" lang="en" aria-label="In English"{% if landing.language == 'en' %} aria-current="page"{% endif %}>EN</a></div>
</header>
<main id="main">
 <noscript><style>.sculpture-stage{display:none}.world-hero{min-height:640px;height:auto}.hero-editorial{width:100%;padding-top:160px;padding-bottom:150px}@media(max-width:700px){.world-hero{min-height:0}.hero-editorial{padding-top:0;padding-bottom:60px}}</style></noscript>
 <section class="world-hero" id="top" aria-labelledby="purpose-title">
  <div class="hero-editorial">
   <p class="eyebrow">{{ experience.location }}</p>
   <h1 id="purpose-title">{{ experience.title | safe }}</h1>
   <p class="hero-subtitle">{{ experience.subtitle | safe }}</p>
   <a class="round-link" href="#wege"><span>{{ experience.explore }}</span></a>
  </div>
  <div class="sculpture-stage" aria-hidden="true"><canvas id="world-canvas"></canvas></div>
  <div class="hero-bottom"><button id="motion-toggle" type="button" data-pause="{{ experience.pause }}" data-play="{{ experience.play }}" aria-pressed="false" hidden><span class="motion-label">{{ experience.pause }}</span></button></div>
 </section>
 <section class="idea-section paper-section" id="idee" aria-labelledby="idea-title">
  <div class="section-top"><span class="eyebrow">{{ experience.chapter }}</span><span class="section-rule"></span></div>
  <div class="idea-grid"><h2 id="idea-title">{{ experience.ideaTitle | safe }}</h2><div class="idea-copy"><p>{{ experience.intro }}</p><p class="small-statement">{{ experience.smallTitle | safe }}</p></div></div>
 </section>
 <section class="programmes-section paper-section" id="wege" aria-labelledby="programmes-title">
  <span id="worum" class="legacy-anchor"></span><span id="ziele" class="legacy-anchor"></span>
  <div class="section-top"><span class="eyebrow">{{ experience.programmesChapter }}</span><span class="section-rule"></span></div>
  <div class="programmes-heading"><h2 id="programmes-title">{{ experience.programmesTitle | safe }}</h2><p>{{ experience.programmesIntro }}</p></div>
  <article class="programme featured-programme" id="lernbus">
   <div class="programme-copy"><div class="programme-meta"><span>01</span><span>{{ experience.lernbusSmall }}</span></div><h3>{{ landing.lernbusTitle }}</h3><p>{{ landing.lernbusDescription }}</p><a class="text-link" href="{{ landing.lernbusUrl }}">{{ landing.action }}</a></div>
   <figure class="room-image"><img src="/lernbus/img/lernraum-spielecke.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="{{ experience.roomAlt }}"><figcaption>{{ experience.roomCaption }}</figcaption></figure>
  </article>
  <div class="future-programmes">
   <article class="programme future-programme" id="forscherbuehne"><div class="programme-meta"><span>02</span><span>{{ experience.eventsSmall }}</span></div><span class="status-label">{{ landing.development }}</span><h3>{{ landing.eventsName }}</h3><p>{{ landing.eventsTitle }}</p></article>
   <article class="programme future-programme" id="gehirn-und-gesellschaft"><div class="programme-meta"><span>03</span><span>{{ experience.schoolsSmall }}</span></div><span class="status-label">{{ landing.development }}</span><h3>{{ landing.schoolsName }}</h3><p>{{ landing.schoolsTitle }}</p></article>
  </div>
 </section>
 <section class="question-section" aria-labelledby="curiosity-question">

  <p class="eyebrow">{{ experience.questionKicker }}</p><h2 id="curiosity-question" aria-live="polite" aria-atomic="true">{{ experience.question | safe }}</h2>
  <button class="question-button" id="next-question" type="button" hidden><span>{{ experience.nextQuestion }}</span></button>
  <script type="application/json" id="curiosity-questions">{{ experience.questions | dump | safe }}</script>
 </section>
 <section class="association-section paper-section" id="verein" aria-labelledby="association-title">
  <span class="legacy-anchor" id="investieren"></span><div class="section-top"><span class="eyebrow">{{ experience.associationChapter }}</span><span class="section-rule"></span></div>
  <div class="association-grid"><h2 id="association-title">{{ experience.associationTitle }}</h2><div><p>{{ experience.associationText }}</p><a class="text-link" href="mailto:team@jonashertner.com" aria-label="{{ experience.mailLabel }}">{{ experience.contact }}</a></div></div>
 </section>
</main>
<footer class="world-footer"><div class="footer-top"><a class="wordmark" href="{{ landing.root }}">Lerngesellschaft<span>Learning Society</span></a><p>Münsterplatz 17<br>4051 Basel, Schweiz</p><a href="{{ landing.imprintUrl }}">{{ landing.imprint }}</a><a href="#top" class="back-top" aria-label="{{ experience.top }}">{{ experience.top }}</a></div><p class="footer-manifesto">{{ experience.footerLine }}</p><div class="footer-bottom"><span>© {{ "2026" }} {{ landing.name }}</span><span>Basel · 47°33′N 7°35′E</span></div></footer>
<script src="/assets/society-evolution.js?v=20261021-evolving-1" defer></script>
<script src="/assets/society-universe-renderer.js?v=20261021-evolving-1" defer></script>
<script src="/assets/society-world.js?v=20261021-evolving-1" defer></script>
<script src="/assets/society-discovery.js?v=20261021-kinetic-1" defer></script>
