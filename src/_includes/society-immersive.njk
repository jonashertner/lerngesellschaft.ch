<header class="world-header">
 <a class="wordmark" href="{{ landing.root }}">Lerngesellschaft<span>Learning Society</span></a>
 <nav class="world-nav" aria-label="{{ experience.navLabel }}">
  <a href="#idee">{{ experience.idea }}</a><a href="#wege">{{ experience.programmes }}</a><a href="#verein">{{ experience.association }}</a>
 </nav>
 <div class="languages"><a href="/" lang="de" aria-label="DE — Auf Deutsch"{% if landing.language == 'de' %} aria-current="page"{% endif %}>DE</a><span aria-hidden="true">/</span><a href="/en/" lang="en" aria-label="EN — In English"{% if landing.language == 'en' %} aria-current="page"{% endif %}>EN</a></div>
</header>
<main id="main">
 <section class="world-hero" id="top" aria-labelledby="purpose-title">
  <div class="hero-editorial">
   <p class="eyebrow">{{ experience.location }}</p>
   <h1 id="purpose-title">{{ experience.title | safe }}</h1>
   <p class="hero-subtitle">{{ experience.subtitle | safe }}</p>
   <div class="hero-actions"><a class="round-link" href="#idee"><span>{{ experience.explore }}</span></a><button id="motion-toggle" type="button" data-pause="{{ experience.pause }}" data-play="{{ experience.play }}" aria-pressed="false" hidden><span class="motion-label">{{ experience.pause }}</span></button></div>
  </div>
  <div class="sculpture-stage" aria-hidden="true"><canvas id="world-canvas"></canvas></div>
  <div class="hero-bottom"><span class="hero-location">{{ experience.footerIdentity }} / Basel</span></div>
 </section>
 <section class="idea-section paper-section" id="idee" aria-labelledby="idea-title">
  <div class="section-top"><span class="eyebrow">{{ experience.chapter }}</span><span class="section-rule" aria-hidden="true"></span></div>
  <div class="idea-grid"><h2 id="idea-title">{{ experience.ideaTitle | safe }}</h2><div class="idea-copy"><p>{{ experience.intro }}</p><p class="small-statement">{{ experience.smallTitle }}</p></div></div>
  <ul class="lifelong-line" aria-label="{{ experience.location }}">{% for word in experience.lifelongWords %}<li>{{ word }}</li>{% endfor %}</ul>
 </section>
 <section class="programmes-section paper-section" id="wege" aria-labelledby="programmes-title">
  <span id="worum" class="legacy-anchor"></span><span id="ziele" class="legacy-anchor"></span>
  <div class="section-top"><span class="eyebrow">{{ experience.programmesChapter }}</span><span class="section-rule" aria-hidden="true"></span></div>
  <div class="programmes-heading"><h2 id="programmes-title">{{ experience.programmesTitle | safe }}</h2><p>{{ experience.programmesIntro }}</p></div>
  <div class="initiative" id="lernbus">
   <span class="eyebrow">{{ experience.lernbusSmall }}</span>
   <a class="initiative-link" href="{{ landing.lernbusUrl }}"><span class="initiative-name">Lernbus</span><span class="initiative-note">{{ experience.lernbusNote }}</span><span class="initiative-action">{{ landing.action }}</span></a>
  </div>
  <span class="legacy-anchor" id="forscherbuehne"></span><span class="legacy-anchor" id="gehirn-und-gesellschaft"></span>
 </section>
</main>
<footer class="world-footer">
 <div class="footer-world-stage" aria-hidden="true"><canvas id="footer-world-canvas"></canvas></div>
 <section class="footer-invitation" id="verein" aria-labelledby="curiosity-question">
  <span class="legacy-anchor" id="investieren"></span>
  <div class="section-top"><p class="eyebrow">{{ experience.questionKicker }}</p><span class="section-rule" aria-hidden="true"></span></div>
  <h2 id="curiosity-question" aria-live="polite" aria-atomic="true">{{ experience.question | safe }}</h2>
  <button class="question-button" id="next-question" type="button" hidden><span>{{ experience.nextQuestion }}</span></button>
  <script type="application/json" id="curiosity-questions">{{ experience.questions | dump | safe }}</script>
  <div class="footer-conversation"><p>{{ experience.associationText }}</p><a class="contact-link" href="mailto:team@jonashertner.com">{{ experience.contact }}</a></div>
 </section>
 <div class="footer-directory">
  <div class="footer-principle"><p>{{ experience.footerLine }}</p><span>{{ experience.footerIdentity }}</span></div>
  <nav aria-label="{{ experience.footerNavLabel }}"><h3 class="eyebrow">{{ experience.footerExplore }}</h3><a href="#idee">{{ experience.idea }}</a><a href="{{ landing.lernbusUrl }}">{{ landing.action }}</a><div class="footer-languages"><a href="/" lang="de"{% if landing.language == 'de' %} aria-current="page"{% endif %}>Deutsch</a><a href="/en/" lang="en"{% if landing.language == 'en' %} aria-current="page"{% endif %}>English</a></div></nav>
  <div class="footer-address"><h3 class="eyebrow">{{ experience.footerAddress }}</h3><address>Münsterplatz 17<br>4051 Basel<br>{{ experience.footerCountry }}</address></div>
 </div>
 <a class="footer-signature" href="{{ landing.root }}"><span>Lerngesellschaft</span><span>Learning Society</span></a>
 <div class="footer-bottom"><span>© 2026 Lerngesellschaft</span><a href="{{ landing.imprintUrl }}">{{ landing.imprint }}</a><button id="footer-motion-toggle" type="button" data-pause="{{ experience.pause }}" data-play="{{ experience.play }}" aria-pressed="false" hidden><span class="motion-label">{{ experience.pause }}</span></button><a href="#top" class="back-top">{{ experience.top }}</a></div>
</footer>
<noscript><style>.sculpture-stage,.footer-world-stage{display:none}.world-hero{min-height:640px;height:auto}.hero-editorial{width:100%;padding-top:160px;padding-bottom:150px}@media(max-width:700px){.world-hero{min-height:0}.hero-editorial{padding-top:0;padding-bottom:60px}}</style></noscript>
<script src="/assets/society-ascii-renderer.js?v=20261028-butterfly-arrival-1" defer></script>
<script src="/assets/society-ascii-world.js?v=20261028-butterfly-arrival-1" defer></script>
<script src="/assets/society-discovery.js?v=20261022-lifelong-1" defer></script>
