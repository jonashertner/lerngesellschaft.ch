{% include "society-site-header.njk" %}
<main id="main">
  <section class="world-hero" aria-labelledby="purpose-title">
    <div class="hero-frame">
      <div class="hero-editorial">
        <p class="eyebrow">{{ s.home.heroEyebrow }}</p>
        <h1 id="purpose-title">{{ s.home.heroTitle | safe }}</h1>
        <p class="hero-subtitle">{{ s.home.heroSubtitle }}</p>
        <div class="hero-actions">
          <a class="hero-cta-primary" href="#angebote"><span>{{ s.home.heroPrimary }}</span><span aria-hidden="true">→</span></a>
          <a class="hero-cta-secondary" href="{% if s.lang == 'en' %}/en/approach/{% else %}/ansatz/{% endif %}"><span>{{ s.home.heroSecondary }}</span></a>
        </div>
      </div>
    </div>
    <div class="sculpture-stage" aria-hidden="true"><canvas id="world-canvas"></canvas></div>
    <div class="hero-bottom">
      <div class="hero-bottom-inner">
        <span class="hero-location">{{ s.home.heroFoot | safe }}</span>
        <button class="motion-btn" id="motion-toggle" type="button" data-pause="{{ s.home.pause }}" data-play="{{ s.home.play }}" aria-pressed="false" hidden><span class="motion-label">{{ s.home.pause }}</span></button>
      </div>
    </div>
  </section>

  <section class="paper-section stone-surface" id="idee" aria-labelledby="idea-title">
    <div class="wrap-inner">
      <div class="section-top"><span class="eyebrow">{{ s.home.ideaKicker }}</span><span class="section-rule" aria-hidden="true"></span></div>
      <div class="chapter-grid" data-reveal>
        <h2 id="idea-title">{{ s.home.ideaTitle | safe }}</h2>
        <div class="chapter-copy">
          <p class="chapter-lead">{{ s.home.ideaLead }}</p>
          <p class="chapter-body">{{ s.home.ideaBody }}</p>
          <a class="inline-action" href="{% if s.lang == 'en' %}/en/approach/{% else %}/ansatz/{% endif %}"><span>{{ s.home.ideaAction }}</span><span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <ul class="principles-strip" aria-label="{{ s.home.pillarsLabel }}" data-reveal>
        {% for item in s.home.pillars %}
        <li>
          <h3 class="pillar-title">{{ item.title }}</h3>
          <p class="pillar-text">{{ item.text }}</p>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  <section class="paper-section paper-surface" id="angebote" aria-labelledby="offers-title">
    <span id="wege" class="legacy-anchor" aria-hidden="true"></span>
    <span id="worum" class="legacy-anchor" aria-hidden="true"></span>
    <span id="ziele" class="legacy-anchor" aria-hidden="true"></span>
    <span id="forscherbuehne" class="legacy-anchor" aria-hidden="true"></span>
    <span id="gehirn-und-gesellschaft" class="legacy-anchor" aria-hidden="true"></span>
    <div class="wrap-inner">
      <div class="section-top"><span class="eyebrow">{{ s.home.offersKicker }}</span><span class="section-rule" aria-hidden="true"></span></div>
      <div class="chapter-grid" data-reveal>
        <h2 id="offers-title">{{ s.home.offersTitle | safe }}</h2>
        <div class="chapter-copy">
          <p class="chapter-lead">{{ s.home.offersIntro }}</p>
        </div>
      </div>
      <div class="programmes-list">
        <article class="programme-row programme-featured" id="lernbus" data-reveal>
          <a class="programme-link" href="{{ s.home.lernbus.url }}">
            <div>
              <div class="programme-meta"><span class="programme-num">{{ s.home.lernbus.number }}</span><span class="status-badge status-badge-active">{{ s.home.activeBadge }}</span></div>
              <span class="programme-name">{{ s.home.lernbus.name }}</span>
              <span class="programme-audience">{{ s.home.lernbus.audience }}</span>
            </div>
            <div class="programme-desc">
              <p>{{ s.home.lernbus.description }}</p>
              <span class="programme-facts">{{ s.home.lernbus.facts }}</span>
            </div>
            <span class="programme-action"><span>{{ s.home.lernbus.action }}</span><span aria-hidden="true">→</span></span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="paper-section stone-surface" id="verein" aria-labelledby="people-title">
    <div class="wrap-inner">
      <div class="section-top"><span class="eyebrow">{{ s.home.peopleKicker }}</span><span class="section-rule" aria-hidden="true"></span></div>
      <div class="chapter-grid" data-reveal>
        <h2 id="people-title">{{ s.home.peopleTitle | safe }}</h2>
        <div class="chapter-copy">
          <p class="chapter-lead">{{ s.home.associationLead | safe }}</p>
          <p class="chapter-body">{{ s.home.associationBody }}</p>
        </div>
      </div>
      <dl class="facts-strip" data-reveal>
        {% for fact in s.home.associationFacts %}
        <div><dt>{{ fact.label }}</dt><dd>{{ fact.value | safe }}</dd></div>
        {% endfor %}
      </dl>
    </div>
  </section>
</main>
{% include "society-site-footer.njk" %}
<noscript><style>.sculpture-stage{display:none}.world-hero{min-height:0}.hero-editorial{width:100%;padding:44px 0 88px}.reveal-pending{opacity:1;transform:none}</style></noscript>
<script src="/assets/society-earth-data.js?v={{ siteAssets.societyEarthData }}" defer></script>
<script src="/assets/society-ascii-renderer.js?v={{ siteAssets.societyAsciiRenderer }}" defer></script>
<script src="/assets/society-ascii-world.js?v={{ siteAssets.societyAsciiWorld }}" defer></script>
